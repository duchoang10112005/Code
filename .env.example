# Sao chép file này thành ".env" rồi điền giá trị. File .env KHÔNG đưa lên Git.

SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Địa chỉ gốc để tạo link trong email
SITE_URL=http://127.0.0.1:8000

# Email thông báo cho gia sư: console (in ra terminal) hoặc smtp (gửi thật)
EMAIL_MODE=console
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=ten@gmail.com
# EMAIL_HOST_PASSWORD=mat-khau-ung-dung-16-ky-tu
# DEFAULT_FROM_EMAIL=Trung tâm gia sư <ten@gmail.com>

# Zoom: fake (giả lập) hoặc real (Server-to-Server OAuth app)
ZOOM_MODE=fake
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Email Zoom dùng làm host khi gia sư chưa có email Zoom riêng
ZOOM_HOST_EMAIL_MAC_DINH=

# Zalo ZNS: fake (giả lập) hoặc real (cần OA doanh nghiệp đã xác thực + template đã duyệt)
ZALO_MODE=fake
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=

# Tham số nghiệp vụ
NGUONG_THAM_GIA=0.67
HAN_XAC_NHAN_GIO=12
HAN_LOI_MOI_GIO=24
NGAY_LUU_BAN_GHI=30
